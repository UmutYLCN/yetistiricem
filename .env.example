# Copy to .env.local (git-ignored) and fill in. Read only by the server
# (Vite dev/preview middleware and `npm start`); never sent to the browser.
# Setup: README → "Oynatma listesi içe aktarma".
YOUTUBE_API_KEY=

# Keşfet (docs/kesfet.md). Public by design: the browser reads them and row level
# security guards the data. Never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
